#--------------------------------------------------------------------
# Copy to `.env` and fill in the real values. Never commit `.env!
#
#   cp .env.example .env
#
# Then bring the schema and demo data up:
#
#   composer migrate   # php spark migrate --all
#   composer seed      # php spark db:seed DatabaseSeeder
#
# `--all` is required: Shield keeps its tables in its own namespace, so a
# plain `php spark migrate` silently leaves you without auth tables.
#
# Demo accounts are seeded with the password Lokapren123! and are for
# development only.
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# Database (Supabase PostgreSQL)
#
# Supabase is the database provider only. Authentication is handled
# entirely by CodeIgniter Shield.
#
# Find these under Supabase Dashboard > Project Settings > Database,
# or from the connection pooler if the direct connection is refused.
#--------------------------------------------------------------------
database.default.hostname =
database.default.database =
database.default.username =
database.default.password =
database.default.port = 5432
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.DBDebug = true
database.default.charset = utf8
